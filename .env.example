# Copy to .env.local for local dev. On Vercel, set these two in
# Settings → Environment Variables instead (this file is never uploaded).

VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# The publishable key. Starts sb_publishable_ — safe to ship in the browser,
# because Row Level Security is what protects the data, not key secrecy.
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxx

# NEVER add the secret key (sb_secret_...) or the legacy service_role key.
# Vite inlines every VITE_ variable into the public bundle, and those keys
# bypass every RLS policy.
