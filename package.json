{
  "name": "eykorban-shipit",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview --host",
    "analyze": "vite build --mode analyze",
    "lighthouse": "lighthouse http://localhost:4173 --view --preset=desktop"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/noto-sans-khmer": "^5.3.0",
    "@supabase/supabase-js": "^2.117.1",
    "@tailwindcss/vite": "^4",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.3.0",
    "lucide-react": "^1.46.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.4.0",
    "shadcn": "^4.21.0",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6",
    "eslint": "^10",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "rollup-plugin-visualizer": "^7.1.1",
    "typescript": "~6",
    "typescript-eslint": "^8",
    "vite": "^8",
    "vite-plugin-pwa": "^1.3.0"
  },
  "description": "EyKorBan PWA — installable, offline-capable, deployed to Vercel."
}
